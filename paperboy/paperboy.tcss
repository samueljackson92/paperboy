/* Paperboy TUI — Monokai color scheme */

$bg:       #272822;
$bg-alt:   #1e1f1c;
$bg-deep:  #1a1b16;
$surface:  #3e3d32;
$surface1: #49483e;
$comment:  #75715e;
$fg-muted: #90907a;
$fg-sub:   #cfcfc2;
$fg:       #f8f8f2;
$yellow:   #e6db74;
$orange:   #fd971f;
$red:      #f92672;
$green:    #a6e22e;
$cyan:     #66d9e8;
$purple:   #ae81ff;

/* ── App shell ───────────────────────────────── */
App {
    background: $bg;
    color: $fg;
}

Header {
    background: $bg-alt;
    color: $purple;
    text-style: bold;
    height: 1;
}

Footer {
    background: $bg-alt;
    color: $comment;
    height: 1;
}

Footer > .footer--key {
    background: $surface;
    color: $cyan;
}

Footer > .footer--highlight {
    background: $surface1;
    color: $fg;
}

/* ── Status bar ──────────────────────────────── */
#status-bar {
    background: $bg-deep;
    color: $fg-muted;
    height: 1;
    padding: 0 1;
    border-bottom: tall $surface;
}

/* ── Paper list ──────────────────────────────── */
PaperList {
    height: 1fr;
    background: $bg;
}

DataTable {
    background: $bg;
    color: $fg;
    height: 1fr;
}

DataTable > .datatable--header {
    background: $surface;
    color: $yellow;
    text-style: bold;
}

DataTable > .datatable--header-hover {
    background: $surface1;
    color: $yellow;
}

DataTable > .datatable--cursor {
    background: $surface1;
    color: $fg;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $bg-alt;
}

DataTable > .datatable--even-row {
    background: $bg;
}

/* ── Loading ─────────────────────────────────── */
LoadingIndicator {
    background: $bg;
    color: $cyan;
}

/* ── Detail modal ────────────────────────────── */
DetailView {
    align: center middle;
    background: $bg 70%;
}

#detail-container {
    background: $bg-alt;
    border: round $purple;
    width: 80%;
    height: 85%;
    padding: 0;
    overflow: hidden;
}

#detail-title {
    color: $green;
    text-style: bold;
    padding: 1 2 0 2;
}

#detail-authors {
    color: $fg-sub;
    padding: 0 2;
}

#detail-meta {
    color: $comment;
    padding: 0 2 1 2;
    border-bottom: tall $surface;
}

#detail-markdown {
    background: $bg-alt;
    color: $fg;
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

#detail-actions {
    height: 3;
    align: right middle;
    padding: 0 2;
    border-top: tall $surface;
}

#close-btn {
    width: auto;
    min-width: 10;
    background: $surface;
    color: $fg-sub;
    border: tall $surface1;
    margin-left: 1;
}

#close-btn:hover {
    background: $surface1;
    color: $fg;
}

#pdf-btn {
    width: auto;
    min-width: 12;
    background: $cyan;
    color: $bg-deep;
    border: tall $cyan;
    text-style: bold;
    margin-left: 1;
}

#pdf-btn:hover {
    background: $green;
    color: $bg-deep;
}

/* ── Filter modal ────────────────────────────── */
FilterPanel {
    align: center middle;
    background: $bg 70%;
}

#filter-title {
    background: $surface;
    color: $yellow;
    text-style: bold;
    padding: 0 2;
    width: 40;
}

OptionList {
    background: $bg-alt;
    border: round $purple;
    color: $fg;
    width: 40;
    height: auto;
    max-height: 20;
}

OptionList > .option-list--option-highlighted {
    background: $surface1;
    color: $fg;
    text-style: bold;
}

OptionList > .option-list--option {
    padding: 0 2;
    color: $fg-sub;
}

OptionList > .option-list--option:hover {
    background: $surface;
    color: $fg;
}
