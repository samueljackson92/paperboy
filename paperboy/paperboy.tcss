/* Paperboy TUI — Monokai color scheme */

$bg:       #272822;
$bg-alt:   #1e1f1c;
$bg-deep:  #1a1b16;
$surface:  #3e3d32;
$surface1: #49483e;
$comment:  #75715e;
$fg-muted: #90907a;
$fg-sub:   #cfcfc2;
$fg:       #f8f8f2;
$yellow:   #e6db74;
$orange:   #fd971f;
$red:      #f92672;
$green:    #a6e22e;
$cyan:     #66d9e8;
$purple:   #ae81ff;

/* ── App shell ───────────────────────────────── */
App {
    background: $bg;
    color: $fg;
}

Header {
    background: $bg-alt;
    color: $purple;
    text-style: bold;
    height: 1;
}

Footer {
    background: $bg-alt;
    color: $comment;
    height: 1;
}

Footer > .footer--key {
    background: $surface;
    color: $cyan;
}

Footer > .footer--highlight {
    background: $surface1;
    color: $fg;
}

/* ── Status bar ──────────────────────────────── */
#status-bar {
    background: $bg-deep;
    color: $fg-muted;
    height: 1;
    padding: 0 1;
    border-bottom: tall $surface;
}

/* ── Tabs ────────────────────────────────────── */
TabbedContent {
    height: 1fr;
    background: $bg;
}

TabbedContent > TabPane {
    padding: 0;
    height: 1fr;
    background: $bg;
}

Tabs {
    background: $bg-alt;
    border-bottom: tall $surface;
}

Tabs > Tab {
    background: $bg-alt;
    color: $comment;
    padding: 0 2;
}

Tabs > Tab:focus {
    color: $fg;
}

Tabs > Tab.-active {
    background: $bg;
    color: $cyan;
    text-style: bold;
}

Tabs > Tab:hover {
    background: $surface;
    color: $fg-sub;
}

Tabs > .tabs--transparent-underline {
    color: $surface;
}

/* ── Paper list ──────────────────────────────── */
PaperList {
    height: 1fr;
    background: $bg;
}

DataTable {
    background: $bg;
    color: $fg;
    height: 1fr;
}

DataTable > .datatable--header {
    background: $surface;
    color: $yellow;
    text-style: bold;
}

DataTable > .datatable--header-hover {
    background: $surface1;
    color: $yellow;
}

DataTable > .datatable--cursor {
    background: $surface1;
    color: $fg;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: $surface;
}

DataTable > .datatable--odd-row {
    background: $bg-alt;
}

DataTable > .datatable--even-row {
    background: $bg;
}

/* ── Loading ─────────────────────────────────── */
LoadingIndicator {
    background: $bg;
    color: $cyan;
}

/* ── Detail pane ─────────────────────────────── */
DetailView {
    height: 14;
    background: $bg-alt;
    border-top: tall $surface;
}

#detail-title {
    color: $green;
    text-style: bold;
    padding: 0 2;
}

#detail-authors {
    color: $fg-sub;
    padding: 0 2;
}

#detail-meta {
    color: $comment;
    padding: 0 2;
}

#detail-markdown {
    background: $bg-alt;
    color: $fg;
    height: 1fr;
    padding: 0 2;
    overflow-y: auto;
}


/* ── Filter modal ────────────────────────────── */
FilterPanel {
    align: center middle;
    background: $bg 70%;
}

#filter-container {
    background: $bg-alt;
    border: round $purple;
    width: 52;
    height: auto;
    max-height: 36;
    padding: 1 2;
}

#filter-title {
    color: $yellow;
    text-style: bold;
    margin-bottom: 1;
}

.filter-label {
    color: $comment;
    margin-top: 1;
}

#filter-keywords {
    background: $surface;
    border: tall $surface1;
    color: $fg;
    width: 1fr;
}

#filter-keywords:focus {
    border: tall $cyan;
}

#filter-source-list {
    background: $bg-alt;
    border: tall $surface;
    color: $fg;
    width: 1fr;
    height: auto;
    max-height: 10;
}

#filter-source-list > .option-list--option-highlighted {
    background: $surface1;
    color: $fg;
    text-style: bold;
}

#filter-source-list > .option-list--option {
    padding: 0 1;
    color: $fg-sub;
}

#filter-bookmarked {
    color: $fg-sub;
    margin-top: 1;
    background: transparent;
}

#filter-bookmarked:focus {
    color: $fg;
}

#filter-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#filter-cancel {
    width: auto;
    min-width: 10;
    background: $surface;
    color: $fg-sub;
    border: tall $surface1;
    margin-left: 1;
}

#filter-cancel:hover {
    background: $surface1;
    color: $fg;
}

#filter-apply {
    width: auto;
    min-width: 10;
    background: $cyan;
    color: $bg-deep;
    border: tall $cyan;
    text-style: bold;
    margin-left: 1;
}

#filter-apply:hover {
    background: $green;
    color: $bg-deep;
}

#filter-save {
    width: auto;
    min-width: 8;
    background: $surface;
    color: $fg-sub;
    border: tall $surface1;
    margin-left: 1;
}

#filter-save:hover {
    background: $surface1;
    color: $fg;
}

#filter-sort {
    background: $surface;
    border: tall $surface1;
    color: $fg;
    width: 1fr;
}

#filter-sort:focus {
    border: tall $cyan;
}

#save-name {
    background: $surface;
    border: tall $cyan;
    color: $fg;
    width: 1fr;
    margin-top: 1;
}

/* ── Vim search bar ──────────────────────────── */
#vim-search {
    height: 1;
    background: $surface;
    border: none;
    color: $cyan;
    padding: 0 1;
}

#vim-search:focus {
    border: none;
    background: $surface1;
}

/* ── Related papers ──────────────────────────── */
#related-list {
    color: $fg-sub;
    padding: 0 2;
    height: auto;
    margin-top: 1;
}

/* ── Saved search panel ──────────────────────── */
SavedSearchPanel {
    align: center middle;
    background: $bg 70%;
}

#saved-container {
    background: $bg-alt;
    border: round $purple;
    width: 70;
    height: auto;
    max-height: 30;
    padding: 1 2;
}

#saved-title {
    color: $yellow;
    text-style: bold;
    margin-bottom: 1;
}

#saved-table {
    background: $bg-alt;
    color: $fg;
    height: auto;
    max-height: 15;
    border: tall $surface;
}

#saved-empty {
    color: $comment;
    padding: 1 0;
}

#saved-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#saved-close {
    width: auto;
    min-width: 8;
    background: $surface;
    color: $fg-sub;
    border: tall $surface1;
    margin-left: 1;
}

#saved-delete {
    width: auto;
    min-width: 8;
    background: $red;
    color: $fg;
    border: tall $red;
    margin-left: 1;
}

#saved-apply {
    width: auto;
    min-width: 8;
    background: $cyan;
    color: $bg-deep;
    border: tall $cyan;
    text-style: bold;
    margin-left: 1;
}

/* ── Export panel ────────────────────────────── */
ExportPanel {
    align: center middle;
    background: $bg 70%;
}

#export-container {
    background: $bg-alt;
    border: round $purple;
    width: 60;
    height: auto;
    padding: 1 2;
}

#export-title {
    color: $yellow;
    text-style: bold;
    margin-bottom: 1;
}

#export-format {
    background: $bg-alt;
    border: none;
    margin-top: 1;
}

#export-path {
    background: $surface;
    border: tall $surface1;
    color: $fg;
    width: 1fr;
    margin-top: 1;
}

#export-path:focus {
    border: tall $cyan;
}

#export-status {
    margin-top: 1;
    height: auto;
}

#export-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#export-cancel {
    width: auto;
    min-width: 10;
    background: $surface;
    color: $fg-sub;
    border: tall $surface1;
    margin-left: 1;
}

#export-apply {
    width: auto;
    min-width: 10;
    background: $cyan;
    color: $bg-deep;
    border: tall $cyan;
    text-style: bold;
    margin-left: 1;
}
